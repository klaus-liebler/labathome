# Klassischer ESP32 (Labathome Rev. 5.x): 4 MB Flash, kein USB-OTG, Console ueber UART0.
# Partitionen: nur factory + storage, keine OTA (s. partitions_esp32.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32.csv"

# Speicher: der klassische ESP32 hat hier kein PSRAM (GPIO16/17 sind anderweitig belegt) und nur ~300 kB DRAM.
# WLAN-Puffer dynamisch statt statisch, TLS-Puffer dynamisch und moderat.
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
