# ESP32-S3-Boards (Labathome ab Rev. 6): 8 MB Flash, PSRAM, USB-OTG (TinyUSB-CDC: Console + Modbus).
# Kleine Dev-Boards: 16 MB Flash bzw. Octal-PSRAM, s. auskommentierte Zeilen.
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Klaus Liebler"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="LabAtHomeProd"
CONFIG_TINYUSB_DESC_SERIAL_STRING="0"
CONFIG_TINYUSB_DESC_CDC_STRING="LabAtHomeDev"
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
